# Copy to .env locally. On Render, set these in the service Environment tab.

# Supabase Postgres — Session pooler (encode / in password as %2F)
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres

# Optional: direct connection for Prisma migrate if pooler fails
# DIRECT_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

PIXABAY_KEY=

# Supabase JS client (frontend auth / REST) — not the database URL
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Production on Render: leave unset so the app calls the same origin (/api/…)
# VITE_API_URL=
