// tells prisma generate a ts prisma client
// put it in generated/prisma 
// backend imports types/client from something like
// import { PrismaClient } from "../../generated/prisma/client.js";

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

// with prisma 7 the connection url lives in prisma.config.ts
datasource db {
  provider = "postgresql"
}

// see eventual update needed in issues.txt
model User {
  id        Int    @id @default(autoincrement())
  firstName String
  lastName  String
  email     String @unique
  phone     String @unique
  cityId    String
  pet       Pet[]
  city      City   @relation(fields: [cityId], references: [id])

  @@index([cityId])
  @@index([lastName])
  @@map("users")
}

model Profile {
  id            String         @id
  email         String         @unique
  firstName     String?
  lastName      String?
  isVerified    Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  favorites     FavoritePet[]
  notifications Notification[]

  @@map("profiles")
}

// powers map markers, pet cards, photo explorers, stats, filters
// species PetSpecies allowed values: dog, cat, other
// breed strategy:
//   breedLabel: "golden retriever"
//   dogBreedSlug: "golden-retriever"
//   catBreedSlug: null
//   otherKind: null
// pet relations:
//   prisma.pet.findMany({
//     include: {
//       owner: true,
//       dogBreed: true,
//       catBreed: true,
//       photos: true,
//     }
//   })
model Pet {
  id            Int             @id @default(autoincrement())
  name          String
  description   String?
  species       PetSpecies
  breedLabel    String
  dogBreedSlug  String?
  catBreedSlug  String?
  otherKind     String?
  ownerId       Int
  latitude      Float
  longitude     Float
  locationLabel String?
  cityName      String?
  stateCode     String?
  notifications Notification[]
  reportStatus  PetReportStatus @default(lost)
  createdAt     DateTime        @default(now())
  photos        PetPhoto[]
  sightings     PetSighting[]
  favorites     FavoritePet[]
  catBreed      CatBreed?       @relation(fields: [catBreedSlug], references: [slug])
  dogBreed      DogBreed?       @relation(fields: [dogBreedSlug], references: [slug])
  owner         User            @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
  @@index([species])
  @@index([reportStatus])
  @@index([breedLabel])
  @@index([dogBreedSlug])
  @@index([catBreedSlug])
  @@index([otherKind])
  @@index([createdAt])
  @@index([species, reportStatus])
  @@index([species, dogBreedSlug])
  @@index([species, catBreedSlug])
  @@index([species, otherKind])
  @@index([latitude, longitude])
  @@map("pets")
}

// lookup/reference table
// example:
//   slug: "golden-retriever"
//   name: "Golden Retriever"
//   commonality: "common"
//   weight: 50
//   group: "sporting"
//   pets: [Pet]
model DogBreed {
  slug        String           @id
  name        String
  commonality BreedCommonality
  weight      Int
  group       BreedGroup?
  pets        Pet[]

  @@index([commonality])
  @@index([weight])
  @@index([name])
  @@map("dog_breeds")
}

// image carousel table, each pet can have many photos
// imagePath can be:
//   /stanford-dogs/...
//   /candid-cats/images/...
//   https://supabase.co/storage/...
// @@unique([petId, imagePath]) means each pet can only have one photo with the same imagePath
// @@index([petId]) means we can quickly find all photos for a pet
// @@index([petId, sortOrder]) means we can quickly find all photos for a pet in order
// @@index([stanfordInstanceKey]) means we can quickly find all photos for a pet by stanfordInstanceKey
// @@index([createdAt]) means we can quickly find all photos for a pet by createdAt
// @@map("pet_photos") means we can quickly find all photos for a pet by map("pet_photos")
model PetPhoto {
  id                  Int      @id @default(autoincrement())
  petId               Int
  imagePath           String   @unique
  sortOrder           Int
  stanfordInstanceKey String?
  createdAt           DateTime @default(now())
  pet                 Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@unique([petId, imagePath])
  @@index([petId])
  @@index([petId, sortOrder])
  @@index([stanfordInstanceKey])
  @@index([createdAt])
  @@map("pet_photos")
}

model PetSighting {
  id                 Int                         @id @default(autoincrement())
  petId              Int
  reporterEmail      String?
  latitude           Float
  longitude          Float
  locationLabel      String?
  notes              String?
  photoUrl           String?
  verificationStatus SightingVerificationStatus  @default(unverified)
  verifiedAt         DateTime?
  notifications      Notification[]
  createdAt          DateTime                    @default(now())

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId])
  @@index([createdAt])
  @@index([latitude, longitude])
  @@index([verificationStatus])
  @@map("pet_sightings")
}

// lookup/reference table
// example:
//   slug: "siamese"
//   name: "Siamese"
//   commonality: "common"
//   weight: 50
//   group: "oriental"
//   pets: [Pet]
model CatBreed {
  slug        String           @id
  name        String
  commonality BreedCommonality
  weight      Int
  group       CatBreedGroup?
  pets        Pet[]

  @@index([commonality])
  @@index([weight])
  @@index([name])
  @@map("cat_breeds")
}

// assigns cities to realistic locations
// supports state filters, city filters, population weighted fake data, map distribution
model City {
  id          String @id
  name        String
  stateCode   String
  stateName   String
  population  Int
  latitude    Float
  longitude   Float
  rankInState Int
  users       User[]

  @@index([stateCode])
  @@index([population])
  @@index([name])
  @@map("cities")
}

model FavoritePet {
  id        Int      @id @default(autoincrement())
  profileId String
  petId     Int
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  pet     Pet     @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@unique([profileId, petId])
  @@index([profileId])
  @@index([petId])
  @@index([createdAt])
  @@map("favorite_pets")
}

model Notification {
  id         Int              @id @default(autoincrement())
  profileId  String
  type       NotificationType
  petId      Int?
  sightingId Int?
  message    String
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  profile  Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  pet      Pet?         @relation(fields: [petId], references: [id], onDelete: Cascade)
  sighting PetSighting? @relation(fields: [sightingId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([profileId, readAt])
  @@index([createdAt])
  @@index([petId])
  @@index([sightingId])
  @@map("notifications")
}

// fixed allowed values
enum PetSpecies {
  dog
  cat
  other
}

enum PetReportStatus {
  lost
  found
  resolved
}

enum BreedCommonality {
  very_common
  common
  uncommon
  rare
  very_rare
}

enum BreedGroup {
  sporting
  hound
  working
  terrier
  toy
  non_sporting
  herding
  misc
  foundation
}

enum CatBreedGroup {
  domestic
  shorthair
  longhair
  semi_longhair
  oriental
  natural
  rex
  hairless
  hybrid
  misc
}

enum NotificationType {
  pet_sighting
  pet_resolved
}

enum SightingVerificationStatus {
  unverified
  verified
}

