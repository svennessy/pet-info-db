generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int    @id @default(autoincrement())
  firstName String
  lastName  String
  email     String @unique
  phone     String @unique
  cityId    String
  pet       Pet?
  city      City   @relation(fields: [cityId], references: [id])

  @@index([cityId])
  @@index([lastName])
  @@map("users")
}

model Pet {
  id           Int             @id @default(autoincrement())
  name         String
  species      PetSpecies
  breedLabel   String
  dogBreedSlug String?
  catBreedSlug String?
  otherKind    String?
  ownerId      Int             @unique
  latitude     Float
  longitude    Float
  reportStatus PetReportStatus @default(lost)
  createdAt    DateTime        @default(now())
  photos       PetPhoto[]
  catBreed     CatBreed?       @relation(fields: [catBreedSlug], references: [slug])
  dogBreed     DogBreed?       @relation(fields: [dogBreedSlug], references: [slug])
  owner        User            @relation(fields: [ownerId], references: [id])

  @@index([species])
  @@index([reportStatus])
  @@index([breedLabel])
  @@index([dogBreedSlug])
  @@index([catBreedSlug])
  @@index([otherKind])
  @@index([createdAt])
  @@index([species, reportStatus])
  @@index([species, dogBreedSlug])
  @@index([species, catBreedSlug])
  @@index([species, otherKind])
  @@index([latitude, longitude])
  @@map("pets")
}

model DogBreed {
  slug        String           @id
  name        String
  commonality BreedCommonality
  weight      Int
  group       BreedGroup?
  pets        Pet[]

  @@index([commonality])
  @@index([weight])
  @@index([name])
  @@map("dog_breeds")
}

model PetPhoto {
  id                  Int      @id @default(autoincrement())
  petId               Int
  imagePath           String
  sortOrder           Int
  stanfordInstanceKey String
  createdAt           DateTime @default(now())
  pet                 Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@unique([petId, imagePath])
  @@index([petId])
  @@index([petId, sortOrder])
  @@index([stanfordInstanceKey])
  @@index([createdAt])
  @@map("pet_photos")
}

model CatBreed {
  slug        String           @id
  name        String
  commonality BreedCommonality
  weight      Int
  group       CatBreedGroup?
  pets        Pet[]

  @@index([commonality])
  @@index([weight])
  @@index([name])
  @@map("cat_breeds")
}

model City {
  id          String @id
  name        String
  stateCode   String
  stateName   String
  population  Int
  latitude    Float
  longitude   Float
  rankInState Int
  users       User[]

  @@index([stateCode])
  @@index([population])
  @@index([name])
  @@map("cities")
}

enum PetSpecies {
  dog
  cat
  other
}

enum PetReportStatus {
  lost
  found
}

enum BreedCommonality {
  very_common
  common
  uncommon
  rare
  very_rare
}

enum BreedGroup {
  sporting
  hound
  working
  terrier
  toy
  non_sporting
  herding
  misc
  foundation
}

enum CatBreedGroup {
  domestic
  shorthair
  longhair
  semi_longhair
  oriental
  natural
  rex
  hairless
  hybrid
  misc
}
